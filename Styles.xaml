<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="AccentBrush" Color="#BCACFF"/>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="#E8E6F0"/><Setter Property="Background" Value="#202127"/>
    <Setter Property="BorderBrush" Value="#303139"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,9"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="11" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shell" Property="Background" Value="#34333F"/><Setter TargetName="Shell" Property="BorderBrush" Value="#696173"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shell" Property="Opacity" Value=".65"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shell" Property="Opacity" Value=".35"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="NavigationTab" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#A69AAF"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="FontSize" Value="11.5"/><Setter Property="Padding" Value="8,4"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid Background="Transparent">
        <Border x:Name="Fill" CornerRadius="8" Background="{DynamicResource AccentBrush}" Opacity="0"/>
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        <Border x:Name="KeyboardMark" Height="2" Width="18" CornerRadius="1" VerticalAlignment="Bottom" Margin="0,0,0,2" Background="{DynamicResource AccentBrush}" Opacity="0"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Opacity" Value=".07"/></Trigger>
        <Trigger Property="Tag" Value="active"><Setter TargetName="Fill" Property="Opacity" Value=".19"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Fill" Property="Opacity" Value=".27"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="KeyboardMark" Property="Opacity" Value="1"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers>
      <Trigger Property="Tag" Value="active">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="#EFEDF6"/><Setter Property="Background" Value="#17181E"/><Setter Property="CaretBrush" Value="#D1C7FF"/>
    <Setter Property="SelectionBrush" Value="#625080"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12"/>
    <Setter Property="FontSize" Value="13"/><Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#3B3846" BorderThickness="1"><ScrollViewer x:Name="PART_ContentHost" Margin="0"/></Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="#DFDCE9"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,5"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
        <ContentPresenter VerticalAlignment="Center"/>
        <Border x:Name="Track" Grid.Column="1" Height="22" Width="38" Background="#34353E" CornerRadius="11"><Ellipse x:Name="Dot" Width="16" Height="16" Fill="#A6A3B1" HorizontalAlignment="Left" Margin="3,0"/></Border>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Dot" Property="Fill" Value="#18151F"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".45"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SliderThumb" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Ellipse Width="13" Height="13" Fill="#F5F2FF"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SliderDecrease" TargetType="RepeatButton"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="{DynamicResource AccentBrush}" CornerRadius="2"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SliderIncrease" TargetType="RepeatButton"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#373640" CornerRadius="2"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider">
    <Setter Property="Height" Value="24"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Background="Transparent" Margin="2,0"><Track x:Name="PART_Track">
      <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderDecrease}"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderIncrease}"/></Track.IncreaseRepeatButton>
    </Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip"><Setter Property="Background" Value="#232129"/><Setter Property="Foreground" Value="#EAE5F8"/><Setter Property="BorderBrush" Value="#49424F"/><Setter Property="Padding" Value="10,6"/></Style>
  <Style x:Key="ScrollThumb" TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="#494150" CornerRadius="3" Margin="1,0"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ScrollSpace" TargetType="RepeatButton"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="7"/><Setter Property="MinWidth" Value="7"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollSpace}"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb MinHeight="24" Style="{StaticResource ScrollThumb}"/></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollSpace}"/></Track.IncreaseRepeatButton>
      </Track></Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
